        print(f"{C.Y}Usage: cd POLYGLOT && python3 polyglot_generator.py python ruby lua{C.X}")

def cmd_fast_scan(args):
    """Run Go-Velocity Core scanner"""
    print_banner()
    print(f"{C.C}⚡ INITIATING GO-VELOCITY CORE...{C.X}\n")
    
    bin_path = NOIZYLAB_ROOT / "bin" / "fast-scan"
    target_dir = str(Path(args.dir).resolve())
    
    if not bin_path.exists():
        print(f"{C.R}Error: Go binary not found at {bin_path}{C.X}")
        return

    print(f"Scanning: {target_dir}")
    try:
        # Run the Go binary, allowing it to print directly to terminals
        # We assume the Go binary prints human-readable stats to Stderr
        subprocess.run([str(bin_path), "-dir", target_dir, "-json", "false"], check=True)
    except subprocess.CalledProcessError as e:
        print(f"{C.R}Scan failed: {e}{C.X}")
    except KeyboardInterrupt:
        print(f"\n{C.Y}Scan aborted.{C.X}")

