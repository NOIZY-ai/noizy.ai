def main():
    parser = argparse.ArgumentParser(
        description='NOIZYLAB CLI - GABRIEL Command Center',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  noizy status          Show system status
  noizy heal            Run World Healer optimization
  noizy scan            Deep code scan
  noizy diag            Run diagnostics
  noizy portal start    Start portal server
  noizy portal stop     Stop portal server
  noizy ai "hello"      Query AI
        """
    )
    
    subparsers = parser.add_subparsers(dest='command', help='Command to run')
    
    # Status
    subparsers.add_parser('status', help='Show all systems status')
    
    # Heal
    subparsers.add_parser('heal', help='Run World Healer optimization')
    
    # Scan
    subparsers.add_parser('scan', help='Deep code scan')
    
    # Diag
    subparsers.add_parser('diag', help='Run system diagnostics')
    
    # Portal
    portal_parser = subparsers.add_parser('portal', help='Control portal server')
    portal_parser.add_argument('action', nargs='?', default='status', 
                               choices=['start', 'stop', 'status'])
    
    # AI
    ai_parser = subparsers.add_parser('ai', help='Query AI models')
    ai_parser.add_argument('query', nargs='*', help='Your question')
    
    # Voice
    subparsers.add_parser('voice', help='Voice command mode')

    # Fast Scan (Go-Velocity)
    scan_parser = subparsers.add_parser('fast-scan', help='Run Go-Velocity file scanner')
    scan_parser.add_argument('dir', nargs='?', default='.', help='Directory to scan')
    
    # AI Command Center Integration
    subparsers.add_parser('ai-status', help='Show AI Command Center status')
    subparsers.add_parser('ai-discover', help='Discover available AI services')
    subparsers.add_parser('ai-diagnose', help='Run AI system diagnostics')
    
    # Smart Chat
    chat_parser = subparsers.add_parser('chat', help='Smart LLM chat with auto-routing')
    chat_parser.add_argument('message', nargs='*', help='Your message')
    
    # Polyglot
    poly_parser = subparsers.add_parser('polyglot', help='Polyglot generator')
    poly_parser.add_argument('action', nargs='?', default='list', choices=['list', 'test', 'generate'])
    
    # Quick actions
    quick_parser = subparsers.add_parser('quick', help='Quick AI actions: fix, improve, explain, tldr')
    quick_parser.add_argument('action', choices=['fix', 'improve', 'explain', 'tldr', 'review', 'idea'])
    quick_parser.add_argument('content', nargs='*', help='Content to process')
    
    # Metrics
    subparsers.add_parser('metrics', help='Show AI usage metrics')
    
    # Ensemble
    ensemble_parser = subparsers.add_parser('ensemble', help='Query multiple AI models')
    ensemble_parser.add_argument('prompt', nargs='*', help='Your prompt')
    
    # GABRIEL
    gabriel_parser = subparsers.add_parser('gabriel', help='GABRIEL unified systems')
    gabriel_parser.add_argument('action', nargs='?', default='status', choices=['status', 'scan', 'hot', 'metrics'])
    
    # Intelligence scan
    intel_parser = subparsers.add_parser('intel', help='Intelligence scan')
    
    args = parser.parse_args()
    
    if args.command == 'status':
        cmd_status(args)
    elif args.command == 'heal':
        cmd_heal(args)
    elif args.command == 'scan':
        cmd_scan(args)
    elif args.command == 'diag':
        cmd_diag(args)
    elif args.command == 'portal':
        cmd_portal(args)
    elif args.command == 'ai':
        cmd_ai(args)
    elif args.command == 'voice':
        cmd_voice(args)
    elif args.command == 'fast-scan':
        cmd_fast_scan(args)
    elif args.command == 'ai-status':
        cmd_ai_center(args, 'status')
    elif args.command == 'ai-discover':
        cmd_ai_center(args, 'discover')
    elif args.command == 'ai-diagnose':
        cmd_ai_center(args, 'diagnose')
    elif args.command == 'chat':
        cmd_smart_chat(args)
    elif args.command == 'polyglot':
        cmd_polyglot(args)
    elif args.command == 'quick':
        cmd_quick(args)
    elif args.command == 'metrics':
        cmd_ai_center(args, 'metrics')
    elif args.command == 'ensemble':
        cmd_ensemble(args)
    elif args.command == 'gabriel':
        cmd_gabriel(args)
    elif args.command == 'intel':
        cmd_intel(args)
    else:
        print_banner()
        parser.print_help()


