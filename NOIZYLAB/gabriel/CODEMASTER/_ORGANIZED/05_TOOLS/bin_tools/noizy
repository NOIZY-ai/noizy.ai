# Colors
class C:
    R = '\033[91m'  # Red
    G = '\033[92m'  # Green
    Y = '\033[93m'  # Yellow
    B = '\033[94m'  # Blue
    M = '\033[95m'  # Magenta
    C = '\033[96m'  # Cyan
    W = '\033[97m'  # White
    X = '\033[0m'   # Reset
    BOLD = '\033[1m'

BANNER = f"""
{C.C}╔══════════════════════════════════════════════════════════════╗
║  {C.BOLD}🌊 NOIZYLAB CLI - GABRIEL COMMAND CENTER{C.X}{C.C}                    ║
║  {C.G}Zero Latency • 100% Optimization • GORUNFREE{C.C}                 ║
╚══════════════════════════════════════════════════════════════╝{C.X}
"""

NOIZYLAB_ROOT = Path.home() / "NOIZYLAB"
PORTAL_DIR = NOIZYLAB_ROOT / "PORTAL"
GABRIEL_DIR = Path.home() / ".gemini/antigravity/playground/iridescent-station/NOIZYLAB_WORKSPACES_LOCAL/GABRIEL_UNIFIED"

def print_banner():
    print(BANNER)

def cmd(command: str, capture=True) -> str:
    """Execute shell command"""
    try:
        result = subprocess.run(command, shell=True, capture_output=capture, text=True, timeout=30)
        return result.stdout.strip() if capture else ""
    except Exception as e:
        return f"Error: {e}"

