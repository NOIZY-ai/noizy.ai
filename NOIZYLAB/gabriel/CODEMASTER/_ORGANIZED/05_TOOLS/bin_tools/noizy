def cmd_status(args):
    """Show all systems status"""
    print_banner()
    print(f"{C.Y}📊 SYSTEM STATUS{C.X}\n")
    
    # CPU
    cpu = cmd("top -l 1 | grep 'CPU usage' | awk '{print $3}'")
    print(f"  {C.G}CPU:{C.X} {cpu}")
    
    # Memory
    mem = cmd("memory_pressure | grep 'System-wide' | head -1")
    print(f"  {C.G}RAM:{C.X} {mem}")
    
    # Portal
    portal_status = cmd("curl -s http://localhost:5185/api/status 2>/dev/null")
    if "ONLINE" in portal_status:
        print(f"  {C.G}Portal:{C.X} 🟢 ONLINE (port 5185)")
    else:
        print(f"  {C.R}Portal:{C.X} 🔴 OFFLINE")
    
    # HP-OMEN
    omen = cmd("ping -c 1 -t 1 10.0.0.160 2>/dev/null | grep 'bytes from'")
    if omen:
        print(f"  {C.G}HP-OMEN:{C.X} 🟢 REACHABLE")
    else:
        print(f"  {C.R}HP-OMEN:{C.X} 🔴 OFFLINE")
    
    # Jumbo Frames
    mtu = cmd("ifconfig en0 | grep mtu | awk '{print $NF}'")
    print(f"  {C.G}MTU:{C.X} {mtu} {'⚡ Jumbo Frames' if mtu == '9000' else ''}")
    
    print()

def cmd_heal(args):
    """Run World Healer"""
    print_banner()
    print(f"{C.M}🌍 INITIATING WORLD HEALER...{C.X}\n")
    
    healer_path = GABRIEL_DIR / "core" / "world_healer.py"
    if healer_path.exists():
        os.system(f"python3 {healer_path}")
    else:
        print(f"{C.R}World Healer not found at {healer_path}{C.X}")
        print("Running inline healing...")
        
        # Inline healing
        print(f"\n{C.Y}1. Cache Cleanup...{C.X}")
        cmd("rm -rf ~/Library/Caches/* 2>/dev/null", capture=False)
        print(f"   {C.G}✅ Done{C.X}")
        
        print(f"{C.Y}2. DNS Flush...{C.X}")
        cmd("dscacheutil -flushcache", capture=False)
        print(f"   {C.G}✅ Done{C.X}")
        
        print(f"{C.Y}3. Memory GC...{C.X}")
        import gc; gc.collect()
        print(f"   {C.G}✅ Done{C.X}")

def cmd_scan(args):
    """Deep code scan"""
    print_banner()
    print(f"{C.C}🔍 SCANNING FOR CODE...{C.X}\n")
    
    locations = [
        ("NOIZYLAB", NOIZYLAB_ROOT),
        ("GABRIEL_UNIFIED", GABRIEL_DIR),
        ("Home/m2ultra", Path.home() / "m2ultra"),
    ]
    
    for name, path in locations:
        if path.exists():
            count = cmd(f"find '{path}' -maxdepth 4 -name '*.py' 2>/dev/null | wc -l").strip()
            print(f"  {C.G}{name}:{C.X} {count} Python files")

def cmd_diag(args):
    """Run diagnostics"""
    print_banner()
    print(f"{C.B}🩺 RUNNING DIAGNOSTICS...{C.X}\n")
    
    result = cmd("curl -s http://localhost:5185/api/diagnose/local 2>/dev/null")
    if result:
        try:
            data = json.loads(result)
            print(f"  {C.G}CPU:{C.X} {data.get('cpu', {}).get('value', 'N/A')}")
            print(f"  {C.G}RAM:{C.X} {data.get('ram', {}).get('value', 'N/A')}")
            print(f"  {C.G}Disk:{C.X} {data.get('disk', {}).get('value', 'N/A')}")
            print(f"  {C.G}Network:{C.X} {data.get('network', {}).get('value', 'N/A')}")
        except:
            print(f"  {C.R}Error parsing response{C.X}")
    else:
        print(f"  {C.R}Portal not responding. Start with: noizy portal start{C.X}")

def cmd_portal(args):
    """Control portal server"""
    print_banner()
    action = args.action if hasattr(args, 'action') else 'status'
    
    if action == 'start':
        print(f"{C.G}🚀 Starting Portal Server...{C.X}")
        os.system(f"cd {PORTAL_DIR} && nohup python3 portal_server.py > /tmp/portal.log 2>&1 &")
        print(f"   Portal starting on http://localhost:5185")
    elif action == 'stop':
        print(f"{C.R}🛑 Stopping Portal Server...{C.X}")
        os.system("pkill -f portal_server.py")
        print(f"   Portal stopped")
    else:
        result = cmd("curl -s http://localhost:5185/api/status 2>/dev/null")
        if "ONLINE" in result:
            print(f"{C.G}Portal: 🟢 ONLINE at http://localhost:5185{C.X}")
        else:
            print(f"{C.R}Portal: 🔴 OFFLINE{C.X}")

def cmd_ai(args):
    """Query AI models"""
    print_banner()
    query = ' '.join(args.query) if hasattr(args, 'query') and args.query else None
    
    if not query:
        print(f"{C.Y}Usage: noizy ai \"your question here\"{C.X}")
        return
    
    print(f"{C.C}🧠 Querying AI...{C.X}\n")
    
    # Try Ollama first (local)
    result = cmd(f'ollama run llama3.2 "{query}" 2>/dev/null')
    if result and "error" not in result.lower():
        print(f"{C.G}GABRIEL:{C.X} {result}")
    else:
        print(f"{C.Y}Ollama not available. Try: ollama serve{C.X}")

