{
  "$schema": "../multimodal_sync.schema.json",
  "sync_id": "sync_a1b2c3d4e5f6g7h8",
  "version": "1.0.0",
  "video_to_voice": {
    "enabled": true,
    "lip_reading": {
      "enabled": true,
      "model": "av_hubert",
      "confidence_threshold": 0.75,
      "language": "en",
      "fallback_to_audio": true
    },
    "timing_extraction": {
      "word_boundaries": true,
      "phoneme_boundaries": true,
      "pause_detection": true,
      "emotion_from_facial": true,
      "speaker_diarization": true
    },
    "dubbing_mode": {
      "enabled": true,
      "preserve_original_timing": true,
      "lip_sync_optimization": true,
      "time_stretch_limit_percent": 15,
      "target_language": "es",
      "translation_model": "nllb-200"
    }
  },
  "voice_to_animation": {
    "enabled": true,
    "face_animation": {
      "method": "audio2face",
      "output_format": "blendshapes",
      "blendshape_set": "arkit_52",
      "fps": 60,
      "smoothing": 0.25
    },
    "lip_sync": {
      "viseme_generation": true,
      "viseme_set": "apple_animoji",
      "coarticulation": true,
      "jaw_movement": true,
      "tongue_approximation": false,
      "teeth_visibility": true
    },
    "facial_expression": {
      "emotion_driven": true,
      "prosody_driven": true,
      "blink_generation": true,
      "blink_rate_per_minute": 17,
      "eyebrow_movement": true,
      "eye_gaze": true,
      "micro_expressions": true,
      "wrinkle_maps": false
    },
    "head_motion": {
      "enabled": true,
      "method": "hybrid",
      "nod_on_emphasis": true,
      "natural_sway": true,
      "look_at_camera": true,
      "motion_amplitude": 0.8
    },
    "body_gesture": {
      "enabled": true,
      "method": "diffusion",
      "gesture_library": "conversational_v2",
      "beat_gesture_detection": true,
      "hand_gestures": true,
      "upper_body_only": true
    }
  },
  "image_to_talking_head": {
    "enabled": true,
    "face_detection": {
      "model": "insightface",
      "multi_face_support": false,
      "face_selection": "largest"
    },
    "animation_method": "liveportrait",
    "output_resolution": {
      "width": 1024,
      "height": 1024,
      "upscaling": true,
      "upscale_factor": 2,
      "upscale_model": "codeformer"
    },
    "background_handling": {
      "preserve_background": true,
      "background_motion": false,
      "background_replacement": false,
      "background_blur": false,
      "green_screen_output": false
    },
    "quality_settings": {
      "temporal_consistency": true,
      "identity_preservation_strength": 0.95,
      "expression_intensity": 1.0,
      "motion_smoothness": 0.6
    }
  },
  "avatar_integration": {
    "enabled": true,
    "avatar_format": "ready_player_me",
    "avatar_source": {
      "type": "url",
      "value": "https://models.readyplayer.me/abc123.glb",
      "platform": "ready_player_me"
    },
    "retargeting": {
      "enabled": true,
      "source_rig": "arkit_52",
      "target_rig": "rpm_skeleton",
      "bone_mapping": "humanoid"
    },
    "rendering": {
      "engine": "threejs",
      "quality_preset": "high",
      "real_time": true,
      "anti_aliasing": true
    },
    "streaming": {
      "enabled": true,
      "protocol": "webrtc",
      "latency_mode": "low"
    }
  },
  "real_time_sync": {
    "enabled": true,
    "target_latency_ms": 80,
    "buffer_size_ms": 150,
    "sync_strategy": "audio_master",
    "drift_correction": {
      "enabled": true,
      "max_correction_ms": 40,
      "correction_method": "interpolation"
    },
    "lip_sync_offset_ms": -20
  },
  "video_generation": {
    "enabled": false,
    "model": "stable_video_diffusion",
    "conditioning": {
      "voice_conditioning": true,
      "text_prompt": "Professional presenter in modern studio",
      "image_prompt": "",
      "style_reference": ""
    },
    "output_settings": {
      "duration_seconds": 30,
      "fps": 24,
      "resolution": "1080p",
      "aspect_ratio": "16:9"
    },
    "character_consistency": {
      "enabled": true,
      "reference_images": [
        "https://cdn.noizyvox.ai/avatars/presenter_ref_1.jpg",
        "https://cdn.noizyvox.ai/avatars/presenter_ref_2.jpg"
      ],
      "identity_strength": 0.85
    }
  },
  "motion_capture": {
    "enabled": true,
    "input_source": "webcam",
    "tracking": {
      "face": true,
      "body": false,
      "hands": true,
      "eye_tracking": false
    },
    "processing": {
      "noise_reduction": true,
      "jitter_filter": true,
      "bone_constraints": true,
      "foot_ik": false
    },
    "recording": {
      "enabled": true,
      "format": "json",
      "frame_rate": 60
    }
  },
  "audio_reactive": {
    "enabled": true,
    "analysis": {
      "amplitude": true,
      "frequency_bands": 8,
      "beat_detection": true,
      "onset_detection": true,
      "pitch_tracking": false
    },
    "visual_mapping": {
      "scale": true,
      "color": true,
      "position": false,
      "rotation": false,
      "particle_emission": false
    },
    "smoothing": {
      "attack_ms": 10,
      "release_ms": 80,
      "interpolation": "ease_out"
    }
  },
  "output_formats": {
    "video": {
      "codec": "h265",
      "container": "mp4",
      "bitrate_mbps": 15,
      "variable_bitrate": true
    },
    "animation": {
      "format": "gltf",
      "include_audio": false,
      "bake_animations": true
    },
    "streaming": {
      "format": "websocket",
      "chunk_duration_ms": 50
    }
  },
  "performance": {
    "gpu_acceleration": true,
    "multi_gpu": false,
    "precision": "fp16",
    "batch_processing": true,
    "cache_models": true,
    "memory_optimization": "gradient_checkpointing"
  },
  "metadata": {
    "created_at": "2024-12-11T10:00:00Z",
    "updated_at": "2024-12-11T10:00:00Z",
    "created_by": "noizyvox_platform",
    "tags": ["production", "avatar", "real-time", "streaming"],
    "notes": "Primary multimodal sync configuration for real-time avatar streaming"
  }
}
