    "ecapa_tdnn": {
      "enabled": true,
      "version": "1.0",
      "repo": "speechbrain/spkrec-ecapa-voxceleb",
      "license": "Apache-2.0",
      "commercial_use": true,
      "config": {
        "embedding_dim": 192,
        "sample_rate": 16000
      }
    },
    "resemblyzer": {
      "enabled": true,
      "version": "0.1.3",
      "repo": "resemble-ai/Resemblyzer",
      "license": "Apache-2.0",
      "commercial_use": true,
      "config": {
        "embedding_dim": 256,
        "sample_rate": 16000
      }
    }
