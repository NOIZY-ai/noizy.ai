  "embedding_models": {
    "bge_m3": {
      "enabled": true,
      "version": "1.0",
      "repo": "BAAI/bge-m3",
      "license": "MIT",
      "commercial_use": true,
      "config": {
        "max_length": 8192,
        "embedding_dim": 1024,
        "pooling_method": "cls"
      }
