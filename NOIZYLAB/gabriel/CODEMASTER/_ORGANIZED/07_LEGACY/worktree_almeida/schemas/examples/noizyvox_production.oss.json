{
  "$schema": "../open_source_integrations.schema.json",
  "integration_id": "oss_a1b2c3d4e5f6g7h8",
  "version": "1.0.0",
  "name": "NOIZYVOX Production OSS Stack",
  "tts_models": {
    "fish_speech": {
      "enabled": true,
      "version": "1.5",
      "repo": "fishaudio/fish-speech",
      "license": "Apache-2.0",
      "commercial_use": true,
      "model_path": "/models/fish-speech-v1.5",
      "config": {
        "sample_rate": 44100,
        "num_codebooks": 4,
        "streaming_enabled": true,
        "chunk_length_ms": 100,
        "zero_shot_enabled": true,
        "reference_audio_min_seconds": 3,
        "reference_audio_max_seconds": 30,
        "supported_languages": ["en", "zh", "ja", "ko", "de", "fr", "es", "it", "pt", "ru"]
      },
      "quantization": {
        "enabled": true,
        "precision": "fp16"
      }
    },
    "xtts_v2": {
      "enabled": true,
      "version": "2.0.3",
      "repo": "coqui-ai/TTS",
      "license": "CPML",
      "commercial_use": false,
      "model_path": "/models/xtts-v2",
      "config": {
        "sample_rate": 24000,
        "gpt_cond_len": 6,
        "gpt_cond_chunk_len": 4,
        "streaming_enabled": true,
        "stream_chunk_size": 20,
        "supported_languages": ["en", "es", "fr", "de", "it", "pt", "pl", "tr", "ru", "nl", "cs", "ar", "zh", "ja", "hu", "ko"]
      }
    },
    "f5_tts": {
      "enabled": true,
      "version": "1.0.0",
      "repo": "SWivid/F5-TTS",
      "license": "MIT",
      "commercial_use": true,
      "model_path": "/models/f5-tts",
      "config": {
        "sample_rate": 24000,
        "nfe_step": 32,
        "cfg_strength": 2.0,
        "sway_sampling_coef": -1.0,
        "speed": 1.0
      }
    },
    "kokoro_tts": {
      "enabled": true,
      "version": "1.0",
      "repo": "hexgrad/Kokoro-82M",
      "license": "Apache-2.0",
      "commercial_use": true,
      "model_path": "/models/kokoro-82m",
      "config": {
        "sample_rate": 24000,
        "cpu_optimized": true,
        "model_size_mb": 82,
        "rtf_cpu": 0.5
      }
    },
    "piper": {
      "enabled": true,
      "version": "1.2.0",
      "repo": "rhasspy/piper",
      "license": "MIT",
      "commercial_use": true,
      "model_path": "/models/piper",
      "config": {
        "sample_rate": 22050,
        "noise_scale": 0.667,
        "length_scale": 1.0,
        "noise_w": 0.8,
        "sentence_silence": 0.2
      }
    },
    "openvoice": {
      "enabled": true,
      "version": "2.0",
      "repo": "myshell-ai/OpenVoice",
      "license": "MIT",
      "commercial_use": true,
      "model_path": "/models/openvoice-v2",
      "config": {
        "sample_rate": 22050,
        "tone_color_conversion": true,
        "cross_lingual": true,
        "instant_cloning": true
      }
    }
  },
  "asr_models": {
    "whisper": {
      "enabled": true,
      "version": "large-v3",
      "repo": "openai/whisper",
      "license": "MIT",
      "commercial_use": true,
      "model_size": "large-v3",
      "config": {
        "compute_type": "float16",
        "beam_size": 5,
        "word_timestamps": true,
        "vad_filter": true,
        "condition_on_previous_text": true
      }
    },
    "faster_whisper": {
      "enabled": true,
      "version": "1.0.0",
      "repo": "SYSTRAN/faster-whisper",
      "license": "MIT",
      "commercial_use": true,
      "config": {
        "device": "auto",
        "compute_type": "float16",
        "cpu_threads": 4,
        "num_workers": 1,
        "batched": true,
        "batch_size": 16
      }
    },
    "whisperx": {
      "enabled": true,
      "version": "3.1.0",
      "repo": "m-bain/whisperX",
      "license": "BSD-4-Clause",
      "commercial_use": true,
      "config": {
        "align_model": true,
        "diarize": true,
        "min_speakers": 1,
        "max_speakers": 10
      }
    }
  },
  "vocoder_models": {
    "bigvgan": {
      "enabled": true,
      "version": "2.0",
      "repo": "NVIDIA/BigVGAN",
      "license": "MIT",
      "commercial_use": true,
      "config": {
        "sample_rate": 24000,
        "hop_size": 256,
        "resblock": "1",
        "upsample_rates": [8, 8, 2, 2]
      }
    },
    "hifigan": {
      "enabled": true,
      "version": "1.0",
      "repo": "jik876/hifi-gan",
      "license": "MIT",
      "commercial_use": true,
      "config": {
        "sample_rate": 22050,
        "resblock_kernel_sizes": [3, 7, 11]
      }
    },
    "vocos": {
      "enabled": true,
      "version": "0.1.0",
      "repo": "gemelo-ai/vocos",
      "license": "MIT",
      "commercial_use": true,
      "config": {
        "sample_rate": 24000,
        "feature_extractor": "encodec",
        "bandwidth": 6.0
      }
    }
  },
  "lip_sync_models": {
    "latentsync": {
      "enabled": true,
      "version": "1.0",
      "repo": "bytedance/LatentSync",
      "license": "Apache-2.0",
      "commercial_use": true,
      "config": {
        "fps": 25,
        "face_detection": "retinaface",
        "audio_encoder": "whisper"
      }
    },
    "wav2lip": {
      "enabled": false,
      "version": "1.0",
      "repo": "Rudrabha/Wav2Lip",
      "license": "CC-BY-NC-4.0",
      "commercial_use": false,
      "config": {
        "fps": 25,
        "pads": [0, 10, 0, 0],
        "face_det_batch_size": 16,
        "wav2lip_batch_size": 128
      }
    },
    "hallo2": {
      "enabled": true,
      "version": "2.0",
      "repo": "fudan-generative-vision/hallo2",
      "license": "MIT",
      "commercial_use": true,
      "config": {
        "fps": 25,
        "long_video_support": true,
        "max_video_length_seconds": 3600
      }
    },
    "liveportrait": {
      "enabled": true,
      "version": "1.0",
      "repo": "KwaiVGI/LivePortrait",
      "license": "MIT",
      "commercial_use": true,
      "config": {
        "stitching": true,
        "relative_motion": true,
        "pasteback": true
      }
    },
    "rhubarb": {
      "enabled": true,
      "version": "1.13.0",
      "repo": "DanielSWolf/rhubarb-lip-sync",
      "license": "MIT",
      "commercial_use": true,
      "config": {
        "recognizer": "phonetic",
        "output_format": "json",
        "extended_shapes": true
      }
    }
  },
  "emotion_models": {
    "emotion2vec": {
      "enabled": true,
      "version": "1.0",
      "repo": "ddlBoJack/emotion2vec",
      "license": "MIT",
      "commercial_use": true,
      "config": {
        "granularity": "utterance",
        "num_emotions": 9
      }
    },
    "go_emotions": {
      "enabled": true,
      "version": "1.0",
      "repo": "google-research/google-research/goemotions",
      "license": "Apache-2.0",
      "commercial_use": true,
      "config": {
        "num_labels": 28,
        "threshold": 0.3,
        "multilabel": true
      }
    },
    "speechbrain_emotion": {
      "enabled": true,
      "version": "0.5.15",
      "repo": "speechbrain/speechbrain",
      "license": "Apache-2.0",
      "commercial_use": true,
      "config": {
        "model_hub": "speechbrain/emotion-recognition-wav2vec2-IEMOCAP",
        "sample_rate": 16000
      }
    }
