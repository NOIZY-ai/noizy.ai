  "api_architecture": {
    "rest_endpoints": {
      "text_to_speech": {
        "endpoint": "POST https://api.openai.com/v1/audio/speech",
        "method": "POST",
        "content_type": "application/json",
        "response_type": "audio/mpeg (streaming)",
        "request_schema": {
          "model": "string (required) - tts-1, tts-1-hd, or gpt-4o-mini-tts",
          "input": "string (required) - Text to synthesize, max 4096 chars",
          "voice": "string (required) - Voice preset ID",
          "response_format": "string (optional) - mp3, opus, aac, flac, wav, pcm",
          "speed": "number (optional) - 0.25 to 4.0, default 1.0",
          "instructions": "string (optional, gpt-4o-mini-tts only)"
        }
      },
      "transcription": {
        "endpoint": "POST https://api.openai.com/v1/audio/transcriptions",
        "method": "POST",
        "content_type": "multipart/form-data",
        "request_schema": {
          "file": "file (required) - Audio file",
          "model": "string (required) - whisper-1, gpt-4o-transcribe, gpt-4o-mini-transcribe",
          "language": "string (optional) - ISO-639-1 code",
          "response_format": "string (optional) - json, text, srt, vtt, verbose_json"
        }
      },
      "translation": {
        "endpoint": "POST https://api.openai.com/v1/audio/translations",
        "method": "POST",
        "description": "Translate audio to English text"
      }
    },
    "websocket_endpoints": {
      "realtime_api": {
        "endpoint": "wss://api.openai.com/v1/realtime",
        "query_params": {
          "model": "gpt-4o-realtime-preview or gpt-4o-mini-realtime-preview"
        },
        "headers": {
          "Authorization": "Bearer $OPENAI_API_KEY",
          "OpenAI-Beta": "realtime=v1"
        },
        "protocol": "WebSocket with JSON messages",
        "audio_format": "Base64 encoded PCM16 at 24kHz mono"
      }
    },
    "webrtc_endpoints": {
      "session_creation": {
        "endpoint": "POST https://api.openai.com/v1/realtime/sessions",
        "description": "Create ephemeral token for browser WebRTC",
        "response": "Ephemeral client token for WebRTC connection"
      }
    }
  },
