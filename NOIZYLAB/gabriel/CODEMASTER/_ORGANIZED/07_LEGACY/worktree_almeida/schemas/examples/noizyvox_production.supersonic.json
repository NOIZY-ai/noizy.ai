{
  "$schema": "../supersonic_pipeline.schema.json",
  "pipeline_id": "sonic_a1b2c3d4e5f6g7h8",
  "version": "1.0.0",
  "name": "NOIZYVOX Production Pipeline",
  "description": "Optimized end-to-end voice synthesis pipeline using best-in-class open-source models",
  "active_tier": "tier_1_premium",
  "recommended_stack": {
    "tier_1_premium": {
      "tts_primary": "Fish Speech V1.5",
      "tts_fallback": "XTTS-v2",
      "voice_cloning": "Fish Speech V1.5",
      "lip_sync_video": "LatentSync",
      "lip_sync_image": "Hallo2",
      "emotion_text": "GoEmotions",
      "emotion_audio": "Emotion2Vec",
      "asr": "Whisper Large V3",
      "vocoder": "BigVGAN V2",
      "llm": "LLaMA 3.3 70B",
      "embeddings": "BGE-M3",
      "vector_db": "Qdrant"
    },
    "tier_2_balanced": {
      "tts_primary": "F5-TTS",
      "tts_fallback": "CosyVoice2",
      "voice_cloning": "OpenVoice V2",
      "lip_sync_video": "Wav2Lip",
      "lip_sync_image": "SadTalker",
      "emotion_text": "DistilRoBERTa Emotion",
      "emotion_audio": "SpeechBrain",
      "asr": "Faster-Whisper",
      "vocoder": "HiFi-GAN",
      "llm": "Qwen 2.5 32B",
      "embeddings": "BGE-M3",
      "vector_db": "ChromaDB"
    },
    "tier_3_edge": {
      "tts_primary": "Kokoro TTS V1.0",
      "tts_fallback": "Piper TTS",
      "voice_cloning": "None (use prebuilt personas)",
      "lip_sync_video": "Rhubarb (visemes only)",
      "lip_sync_image": "LivePortrait",
      "emotion_text": "DistilBERT Emotion",
      "emotion_audio": "None",
      "asr": "Whisper Tiny",
      "vocoder": "Vocos",
      "llm": "Gemma 2 9B (llama.cpp)",
      "embeddings": "all-MiniLM-L6-v2",
      "vector_db": "SQLite-VSS"
    }
  },
  "pipeline_stages": [
    {
      "stage": "1_script_analysis",
      "models": ["LLaMA 3.3 70B", "GoEmotions", "BGE-M3"],
      "description": "Analyze script for emotions, emphasis, pacing",
      "latency_target_ms": 500,
      "gpu_required": true,
      "can_stream": false,
      "parallelizable": false
    },
    {
      "stage": "2_ssml_generation",
      "models": ["LLaMA 3.3 70B"],
      "description": "Generate production SSML with prosody markup",
      "latency_target_ms": 300,
      "gpu_required": true,
      "can_stream": true,
      "parallelizable": false
    },
    {
      "stage": "3_persona_retrieval",
      "models": ["BGE-M3", "Qdrant"],
      "description": "Retrieve persona characteristics for consistency",
      "latency_target_ms": 50,
      "gpu_required": false,
      "can_stream": false,
      "parallelizable": true
    },
    {
      "stage": "4_voice_synthesis",
      "models": ["Fish Speech V1.5", "BigVGAN V2"],
      "description": "Generate speech from SSML",
      "latency_target_ms": 200,
      "gpu_required": true,
      "can_stream": true,
      "parallelizable": false
    },
    {
      "stage": "5_audio_enhancement",
      "models": ["DeepFilterNet", "Resemble Enhance"],
      "description": "Noise reduction and quality enhancement",
      "latency_target_ms": 100,
      "gpu_required": false,
      "can_stream": true,
      "parallelizable": false
    },
    {
      "stage": "6_quality_assessment",
      "models": ["UTMOS", "ECAPA-TDNN"],
      "description": "Validate quality and speaker similarity",
      "latency_target_ms": 50,
      "gpu_required": false,
      "can_stream": false,
      "parallelizable": true
    },
    {
      "stage": "7_lip_sync_generation",
      "models": ["LatentSync", "Rhubarb"],
      "description": "Generate lip sync animation",
      "latency_target_ms": 500,
      "gpu_required": true,
      "can_stream": false,
      "parallelizable": true,
      "skip_conditions": ["no_video_output", "audio_only"]
    },
    {
      "stage": "8_watermarking",
      "models": ["AudioSeal", "Custom spectral"],
      "description": "Embed provenance watermark",
      "latency_target_ms": 20,
      "gpu_required": false,
      "can_stream": true,
      "parallelizable": false
    }
  ],
  "model_registry": {
    "fish_speech_v1.5": {
      "name": "Fish Speech V1.5",
      "version": "1.5.0",
      "repo": "fishaudio/fish-speech",
