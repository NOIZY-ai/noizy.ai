      "commercial_use": true,
      "model_size_gb": 2.8,
      "vram_required_gb": 6,
      "quantization_options": ["fp16", "int8"],
      "supported_languages": ["en", "zh", "ja", "ko", "de", "fr", "es", "it", "pt", "ru"],
      "latency_benchmark_ms": {
