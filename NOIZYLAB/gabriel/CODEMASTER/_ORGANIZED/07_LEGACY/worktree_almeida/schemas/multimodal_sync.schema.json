{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noizyvox.ai/schemas/multimodal_sync.schema.json",
  "title": "NOIZYVOX Multimodal Sync",
  "description": "Video, image, and animation synchronization with voice",
  "type": "object",
  "required": ["sync_id", "version"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "sync_id": {
      "type": "string",
      "pattern": "^sync_[a-z0-9]{16}$",
      "description": "Unique identifier for the multimodal sync configuration"
    },
    "version": {
      "type": "string",
      "description": "Schema version"
    },
    "video_to_voice": {
      "type": "object",
      "description": "Generate voice from video input",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "lip_reading": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "model": { 
              "type": "string",
              "enum": ["av_hubert", "lipreading_tcn", "visual_speech", "custom"],
              "description": "Lip reading model"
            },
            "confidence_threshold": { 
              "type": "number", 
              "minimum": 0,
              "maximum": 1,
              "default": 0.7 
            },
            "language": { "type": "string", "default": "en" },
            "fallback_to_audio": { "type": "boolean", "default": true }
          }
        },
        "timing_extraction": {
          "type": "object",
          "properties": {
            "word_boundaries": { "type": "boolean", "default": true },
            "phoneme_boundaries": { "type": "boolean", "default": true },
            "pause_detection": { "type": "boolean", "default": true },
            "emotion_from_facial": { "type": "boolean", "default": true },
            "speaker_diarization": { "type": "boolean", "default": false }
          }
        },
        "dubbing_mode": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "preserve_original_timing": { "type": "boolean", "default": true },
            "lip_sync_optimization": { "type": "boolean", "default": true },
            "time_stretch_limit_percent": { "type": "number", "default": 20 },
            "target_language": { "type": "string" },
            "translation_model": { "type": "string" }
          }
        }
      }
    },
    "voice_to_animation": {
      "type": "object",
      "description": "Generate animation from voice",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "face_animation": {
          "type": "object",
          "properties": {
            "method": { 
              "type": "string",
              "enum": ["audio2face", "wav2lip", "sadtalker", "genehead", "custom"],
              "description": "Face animation method"
            },
            "output_format": { 
              "type": "string",
              "enum": ["blendshapes", "mesh_vertices", "video", "arkit_params"]
            },
            "blendshape_set": { 
              "type": "string",
              "enum": ["arkit_52", "facs", "oculus", "custom"]
            },
            "fps": { "type": "integer", "minimum": 1, "maximum": 120, "default": 60 },
            "smoothing": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.3 }
          }
        },
        "lip_sync": {
          "type": "object",
          "properties": {
            "viseme_generation": { "type": "boolean", "default": true },
            "viseme_set": {
              "type": "string",
              "enum": ["ipa", "arpabet", "oculus_15", "apple_animoji", "custom"]
            },
            "coarticulation": { "type": "boolean", "default": true },
            "jaw_movement": { "type": "boolean", "default": true },
            "tongue_approximation": { "type": "boolean", "default": false },
            "teeth_visibility": { "type": "boolean", "default": true }
          }
        },
        "facial_expression": {
          "type": "object",
          "properties": {
            "emotion_driven": { "type": "boolean", "default": true },
            "prosody_driven": { "type": "boolean", "default": true },
            "blink_generation": { "type": "boolean", "default": true },
            "blink_rate_per_minute": { "type": "number", "default": 15 },
            "eyebrow_movement": { "type": "boolean", "default": true },
            "eye_gaze": { "type": "boolean", "default": true },
            "micro_expressions": { "type": "boolean", "default": true },
            "wrinkle_maps": { "type": "boolean", "default": false }
          }
        },
        "head_motion": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "method": { 
              "type": "string",
              "enum": ["audio_driven", "rule_based", "neural", "hybrid"]
            },
            "nod_on_emphasis": { "type": "boolean", "default": true },
            "natural_sway": { "type": "boolean", "default": true },
            "look_at_camera": { "type": "boolean", "default": true },
            "motion_amplitude": { "type": "number", "minimum": 0, "maximum": 2, "default": 1.0 }
          }
        },
        "body_gesture": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "method": { 
              "type": "string",
              "enum": ["audio2gesture", "rule_based", "diffusion", "custom"]
            },
            "gesture_library": { "type": "string" },
            "beat_gesture_detection": { "type": "boolean", "default": true },
            "hand_gestures": { "type": "boolean", "default": true },
            "upper_body_only": { "type": "boolean", "default": true }
          }
        }
      }
    },
    "image_to_talking_head": {
      "type": "object",
      "description": "Animate still image with voice",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "face_detection": {
          "type": "object",
          "properties": {
            "model": { 
              "type": "string",
              "enum": ["mediapipe", "dlib", "insightface", "custom"]
            },
            "multi_face_support": { "type": "boolean", "default": false },
            "face_selection": {
              "type": "string",
              "enum": ["largest", "center", "manual", "all"]
            }
          }
        },
        "animation_method": {
          "type": "string",
          "enum": ["sadtalker", "wav2lip", "makeittalk", "audio2head", "liveportrait", "custom"]
        },
        "output_resolution": {
          "type": "object",
          "properties": {
            "width": { "type": "integer", "minimum": 64, "default": 512 },
            "height": { "type": "integer", "minimum": 64, "default": 512 },
            "upscaling": { "type": "boolean", "default": true },
            "upscale_factor": { "type": "integer", "minimum": 1, "maximum": 4, "default": 2 },
            "upscale_model": { 
              "type": "string",
              "enum": ["realesrgan", "gfpgan", "codeformer", "custom"]
            }
          }
        },
        "background_handling": {
          "type": "object",
          "properties": {
            "preserve_background": { "type": "boolean", "default": true },
            "background_motion": { "type": "boolean", "default": false },
            "background_replacement": { "type": "boolean", "default": false },
            "background_blur": { "type": "boolean", "default": false },
            "green_screen_output": { "type": "boolean", "default": false }
          }
        },
        "quality_settings": {
          "type": "object",
          "properties": {
            "temporal_consistency": { "type": "boolean", "default": true },
            "identity_preservation_strength": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.9 },
            "expression_intensity": { "type": "number", "minimum": 0, "maximum": 2, "default": 1.0 },
            "motion_smoothness": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 }
          }
        }
      }
    },
    "avatar_integration": {
      "type": "object",
      "description": "3D avatar and virtual character integration",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "avatar_format": {
          "type": "string",
          "enum": ["ready_player_me", "vrm", "metahuman", "daz3d", "mixamo", "custom"],
          "description": "Avatar format/platform"
        },
        "avatar_source": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["url", "file", "platform_id", "generated"]
            },
            "value": { "type": "string" },
            "platform": { "type": "string" }
          }
        },
        "retargeting": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "source_rig": { "type": "string" },
            "target_rig": { "type": "string" },
            "bone_mapping": {
              "type": "string",
              "enum": ["auto", "humanoid", "custom"]
            }
          }
        },
        "rendering": {
          "type": "object",
          "properties": {
            "engine": {
              "type": "string",
              "enum": ["unity", "unreal", "threejs", "babylonjs", "custom"]
            },
            "quality_preset": {
              "type": "string",
              "enum": ["low", "medium", "high", "ultra", "mobile"]
            },
            "real_time": { "type": "boolean", "default": true },
            "anti_aliasing": { "type": "boolean", "default": true }
          }
        },
        "streaming": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "protocol": {
              "type": "string",
              "enum": ["webrtc", "hls", "dash", "rtmp"]
            },
            "latency_mode": {
              "type": "string",
              "enum": ["ultra_low", "low", "normal"]
            }
          }
        }
      }
    },
    "real_time_sync": {
      "type": "object",
      "description": "Real-time synchronization settings",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "target_latency_ms": { 
          "type": "integer", 
          "minimum": 0,
          "default": 100 
        },
        "buffer_size_ms": { 
          "type": "integer", 
          "minimum": 0,
          "default": 200 
        },
        "sync_strategy": {
          "type": "string",
          "enum": ["audio_master", "video_master", "adaptive"],
          "description": "Which stream is master for sync"
        },
        "drift_correction": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "max_correction_ms": { "type": "integer", "default": 50 },
            "correction_method": {
              "type": "string",
              "enum": ["time_stretch", "frame_drop", "interpolation"]
            }
          }
        },
        "lip_sync_offset_ms": {
          "type": "integer",
          "description": "Manual offset for lip sync adjustment",
          "default": 0
        }
      }
    },
    "video_generation": {
      "type": "object",
      "description": "AI video generation from voice",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "model": {
          "type": "string",
          "enum": ["stable_video_diffusion", "pika", "runway_gen3", "sora", "custom"],
          "description": "Video generation model"
        },
        "conditioning": {
          "type": "object",
          "properties": {
            "voice_conditioning": { "type": "boolean", "default": true },
            "text_prompt": { "type": "string" },
            "image_prompt": { "type": "string" },
            "style_reference": { "type": "string" }
          }
        },
        "output_settings": {
          "type": "object",
          "properties": {
            "duration_seconds": { "type": "number", "minimum": 1, "maximum": 300 },
            "fps": { "type": "integer", "default": 24 },
            "resolution": {
              "type": "string",
              "enum": ["480p", "720p", "1080p", "4k"]
            },
            "aspect_ratio": {
              "type": "string",
              "enum": ["16:9", "9:16", "1:1", "4:3", "21:9"]
            }
          }
        },
        "character_consistency": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "reference_images": {
              "type": "array",
              "items": { "type": "string" }
            },
            "identity_strength": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.8 }
          }
        }
      }
    },
    "motion_capture": {
      "type": "object",
      "description": "Motion capture input and processing",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "input_source": {
          "type": "string",
          "enum": ["webcam", "depth_camera", "suit", "gloves", "file"]
        },
        "tracking": {
          "type": "object",
          "properties": {
            "face": { "type": "boolean", "default": true },
            "body": { "type": "boolean", "default": false },
            "hands": { "type": "boolean", "default": false },
            "eye_tracking": { "type": "boolean", "default": false }
          }
        },
        "processing": {
          "type": "object",
          "properties": {
            "noise_reduction": { "type": "boolean", "default": true },
            "jitter_filter": { "type": "boolean", "default": true },
            "bone_constraints": { "type": "boolean", "default": true },
            "foot_ik": { "type": "boolean", "default": false }
          }
        },
        "recording": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "format": {
              "type": "string",
              "enum": ["fbx", "bvh", "json", "c3d"]
            },
            "frame_rate": { "type": "integer", "default": 60 }
          }
        }
      }
    },
    "audio_reactive": {
      "type": "object",
      "description": "Audio-reactive visual effects",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "analysis": {
          "type": "object",
          "properties": {
            "amplitude": { "type": "boolean", "default": true },
            "frequency_bands": { "type": "integer", "minimum": 1, "maximum": 64, "default": 8 },
            "beat_detection": { "type": "boolean", "default": true },
            "onset_detection": { "type": "boolean", "default": true },
            "pitch_tracking": { "type": "boolean", "default": false }
          }
        },
        "visual_mapping": {
          "type": "object",
          "properties": {
            "scale": { "type": "boolean", "default": true },
            "color": { "type": "boolean", "default": true },
            "position": { "type": "boolean", "default": false },
            "rotation": { "type": "boolean", "default": false },
            "particle_emission": { "type": "boolean", "default": false }
          }
        },
        "smoothing": {
          "type": "object",
          "properties": {
            "attack_ms": { "type": "integer", "minimum": 0, "default": 10 },
            "release_ms": { "type": "integer", "minimum": 0, "default": 100 },
            "interpolation": {
              "type": "string",
              "enum": ["linear", "ease_in", "ease_out", "ease_in_out"]
            }
          }
        }
      }
    },
    "output_formats": {
      "type": "object",
      "description": "Output format configuration",
      "properties": {
        "video": {
          "type": "object",
          "properties": {
            "codec": {
              "type": "string",
              "enum": ["h264", "h265", "vp9", "av1", "prores"]
            },
            "container": {
              "type": "string",
              "enum": ["mp4", "webm", "mov", "mkv"]
            },
            "bitrate_mbps": { "type": "number" },
            "variable_bitrate": { "type": "boolean", "default": true }
          }
        },
        "animation": {
          "type": "object",
          "properties": {
            "format": {
              "type": "string",
              "enum": ["json", "fbx", "gltf", "usd", "binary"]
            },
            "include_audio": { "type": "boolean", "default": false },
            "bake_animations": { "type": "boolean", "default": false }
          }
        },
        "streaming": {
          "type": "object",
          "properties": {
            "format": {
              "type": "string",
              "enum": ["websocket", "webrtc", "grpc", "sse"]
            },
            "chunk_duration_ms": { "type": "integer", "default": 50 }
          }
        }
      }
    },
    "performance": {
      "type": "object",
      "description": "Performance optimization settings",
      "properties": {
        "gpu_acceleration": { "type": "boolean", "default": true },
        "multi_gpu": { "type": "boolean", "default": false },
        "precision": {
          "type": "string",
          "enum": ["fp32", "fp16", "bf16", "int8"]
        },
        "batch_processing": { "type": "boolean", "default": true },
        "cache_models": { "type": "boolean", "default": true },
        "memory_optimization": {
          "type": "string",
          "enum": ["none", "gradient_checkpointing", "model_offload", "aggressive"]
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "created_by": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "string" }
      }
    }
  },
  "additionalProperties": false
}
