{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noizyvox.ai/schemas/openai_voice_integration.schema.json",
  "title": "NOIZYVOX OpenAI Voice Integration",
  "description": "Complete OpenAI voice API, SDK, and model integration for professional voice synthesis, ASR, and realtime agents - December 2025",
  "type": "object",
  "required": ["integration_id", "version", "provider"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "integration_id": {
      "type": "string",
      "pattern": "^oai_voice_[a-z0-9]{16}$",
      "description": "Unique identifier for OpenAI voice integration"
    },
    "version": {
      "type": "string",
      "default": "2.0.0",
      "description": "Integration version"
    },
    "provider": {
      "type": "string",
      "const": "openai",
      "description": "Voice provider identifier"
    },
    "api_configuration": {
      "type": "object",
      "description": "OpenAI API configuration",
      "properties": {
        "api_key": {
          "type": "string",
          "pattern": "^sk-[a-zA-Z0-9-_]+$",
          "description": "OpenAI API key (stored securely)"
        },
        "organization_id": {
          "type": "string",
          "pattern": "^org-[a-zA-Z0-9]+$",
          "description": "OpenAI organization ID"
        },
        "base_url": {
          "type": "string",
          "format": "uri",
          "default": "https://api.openai.com/v1",
          "description": "OpenAI API base URL"
        },
        "azure_endpoint": {
          "type": "string",
          "format": "uri",
          "description": "Azure OpenAI endpoint (optional)"
        },
        "azure_deployment_name": {
          "type": "string",
          "description": "Azure OpenAI deployment name"
        },
        "api_version": {
          "type": "string",
          "default": "2024-12-01",
          "description": "API version"
        },
        "timeout_ms": {
          "type": "integer",
          "default": 30000,
          "minimum": 1000,
          "maximum": 120000
        },
        "max_retries": {
          "type": "integer",
          "default": 3,
          "minimum": 0,
          "maximum": 10
        }
      }
    },
    "tts_models": {
      "type": "object",
      "description": "Text-to-Speech model configurations",
      "properties": {
        "tts_1": {
          "type": "object",
          "description": "Standard TTS model optimized for speed",
          "properties": {
            "model_id": { "type": "string", "const": "tts-1" },
            "enabled": { "type": "boolean", "default": true },
            "use_case": { "type": "string", "default": "Fast, real-time applications" },
            "max_input_chars": { "type": "integer", "default": 4096 },
            "supported_voices": {
              "type": "array",
              "items": { "type": "string" },
              "default": ["alloy", "ash", "ballad", "coral", "echo", "fable", "onyx", "nova", "sage", "shimmer", "verse"]
            },
            "supported_formats": {
              "type": "array",
              "items": { "type": "string" },
              "default": ["mp3", "opus", "aac", "flac", "wav", "pcm"]
            },
            "speed_range": {
              "type": "object",
              "properties": {
                "min": { "type": "number", "default": 0.25 },
                "max": { "type": "number", "default": 4.0 },
                "default": { "type": "number", "default": 1.0 }
              }
            },
            "pricing": {
              "type": "object",
              "properties": {
                "per_1m_chars": { "type": "number", "default": 15.00 },
                "unit": { "type": "string", "default": "USD" }
              }
            },
            "streaming_enabled": { "type": "boolean", "default": false },
            "instruction_guided": { "type": "boolean", "default": false }
          }
        },
        "tts_1_hd": {
          "type": "object",
          "description": "HD TTS model optimized for quality",
          "properties": {
            "model_id": { "type": "string", "const": "tts-1-hd" },
            "enabled": { "type": "boolean", "default": true },
            "use_case": { "type": "string", "default": "Studio quality, audiobooks, premium content" },
            "max_input_chars": { "type": "integer", "default": 4096 },
            "supported_voices": {
              "type": "array",
              "items": { "type": "string" },
              "default": ["alloy", "ash", "ballad", "coral", "echo", "fable", "onyx", "nova", "sage", "shimmer", "verse"]
            },
            "supported_formats": {
              "type": "array",
              "items": { "type": "string" },
              "default": ["mp3", "opus", "aac", "flac", "wav", "pcm"]
            },
            "pricing": {
              "type": "object",
              "properties": {
                "per_1m_chars": { "type": "number", "default": 30.00 },
                "unit": { "type": "string", "default": "USD" }
              }
            },
            "streaming_enabled": { "type": "boolean", "default": false },
            "instruction_guided": { "type": "boolean", "default": false }
          }
        },
        "gpt_4o_mini_tts": {
          "type": "object",
          "description": "Instruction-guided TTS powered by GPT-4o mini",
          "properties": {
            "model_id": { "type": "string", "const": "gpt-4o-mini-tts" },
            "enabled": { "type": "boolean", "default": true },
            "use_case": { "type": "string", "default": "Custom personas, emotions, theatrical performances" },
            "max_input_chars": { "type": "integer", "default": 4096 },
            "instruction_guided": { "type": "boolean", "default": true },
            "supported_voices": {
              "type": "array",
              "items": { "type": "string" },
              "default": ["alloy", "ash", "ballad", "coral", "echo", "fable", "onyx", "nova", "sage", "shimmer", "verse"]
            },
            "supported_formats": {
              "type": "array",
              "items": { "type": "string" },
              "default": ["mp3", "opus", "aac", "flac", "wav", "pcm"]
            },
            "streaming_enabled": { "type": "boolean", "default": true },
            "stream_formats": {
              "type": "array",
              "items": { "type": "string" },
              "default": ["sse", "audio"]
            },
            "pricing": {
              "type": "object",
              "properties": {
                "text_input_per_1m_tokens": { "type": "number", "default": 0.60 },
                "audio_output_per_1m_tokens": { "type": "number", "default": 12.00 },
                "per_minute_audio": { "type": "number", "default": 0.015 },
                "unit": { "type": "string", "default": "USD" }
              }
            },
            "instruction_examples": {
              "type": "array",
              "items": { "type": "string" },
              "default": [
                "Speak with a warm, friendly tone",
                "Use an excited, enthusiastic voice",
                "Deliver this as a dramatic reading",
                "Speak softly and calmly, like a meditation guide",
                "Use a professional news anchor delivery",
                "Add emphasis on key points like a motivational speaker"
              ]
            }
          }
        }
      }
    },
    "asr_models": {
      "type": "object",
      "description": "Automatic Speech Recognition (Speech-to-Text) models",
      "properties": {
        "whisper_1": {
          "type": "object",
          "description": "General-purpose speech recognition (Whisper V2)",
          "properties": {
            "model_id": { "type": "string", "const": "whisper-1" },
            "enabled": { "type": "boolean", "default": true },
            "use_case": { "type": "string", "default": "General transcription, 99 languages" },
            "supported_formats": {
              "type": "array",
              "items": { "type": "string" },
              "default": ["flac", "mp3", "mp4", "mpeg", "mpga", "m4a", "ogg", "wav", "webm"]
            },
            "max_file_size_mb": { "type": "integer", "default": 25 },
            "supported_languages": { "type": "integer", "default": 99 },
            "response_formats": {
              "type": "array",
              "items": { "type": "string" },
              "default": ["json", "text", "srt", "verbose_json", "vtt"]
            },
            "timestamp_granularities": {
              "type": "array",
              "items": { "type": "string" },
              "default": ["word", "segment"]
            },
            "translation_supported": { "type": "boolean", "default": true },
            "streaming_supported": { "type": "boolean", "default": false },
            "pricing": {
              "type": "object",
              "properties": {
                "per_minute": { "type": "number", "default": 0.006 },
                "unit": { "type": "string", "default": "USD" }
              }
            }
          }
        },
        "gpt_4o_transcribe": {
          "type": "object",
          "description": "High-accuracy transcription powered by GPT-4o",
          "properties": {
            "model_id": { "type": "string", "const": "gpt-4o-transcribe" },
            "enabled": { "type": "boolean", "default": true },
            "use_case": { "type": "string", "default": "Best accuracy, complex audio, noisy environments" },
            "supported_formats": {
              "type": "array",
              "items": { "type": "string" },
              "default": ["flac", "mp3", "mp4", "mpeg", "mpga", "m4a", "ogg", "wav", "webm"]
            },
            "response_formats": {
              "type": "array",
              "items": { "type": "string" },
              "default": ["json"]
            },
            "streaming_supported": { "type": "boolean", "default": true },
            "logprobs_supported": { "type": "boolean", "default": true },
            "pricing": {
              "type": "object",
              "properties": {
                "text_input_per_1m_tokens": { "type": "number", "default": 2.50 },
                "text_output_per_1m_tokens": { "type": "number", "default": 10.00 },
                "audio_input_per_1m_tokens": { "type": "number", "default": 6.00 },
                "per_minute": { "type": "number", "default": 0.006 },
                "unit": { "type": "string", "default": "USD" }
              }
            }
          }
        },
        "gpt_4o_mini_transcribe": {
          "type": "object",
          "description": "Fast, cost-efficient transcription powered by GPT-4o mini",
          "properties": {
            "model_id": { "type": "string", "const": "gpt-4o-mini-transcribe" },
            "enabled": { "type": "boolean", "default": true },
            "use_case": { "type": "string", "default": "High volume, cost-sensitive transcription" },
            "supported_formats": {
              "type": "array",
              "items": { "type": "string" },
              "default": ["flac", "mp3", "mp4", "mpeg", "mpga", "m4a", "ogg", "wav", "webm"]
            },
            "response_formats": {
              "type": "array",
              "items": { "type": "string" },
              "default": ["json"]
            },
            "streaming_supported": { "type": "boolean", "default": true },
            "logprobs_supported": { "type": "boolean", "default": true },
            "pricing": {
              "type": "object",
              "properties": {
                "text_input_per_1m_tokens": { "type": "number", "default": 1.25 },
                "text_output_per_1m_tokens": { "type": "number", "default": 5.00 },
                "audio_input_per_1m_tokens": { "type": "number", "default": 3.00 },
                "per_minute": { "type": "number", "default": 0.003 },
                "unit": { "type": "string", "default": "USD" }
              }
            }
          }
        },
        "gpt_4o_transcribe_diarize": {
          "type": "object",
          "description": "Transcription with speaker diarization",
          "properties": {
            "model_id": { "type": "string", "const": "gpt-4o-transcribe-diarize" },
            "enabled": { "type": "boolean", "default": true },
            "use_case": { "type": "string", "default": "Multi-speaker conversations, interviews, meetings" },
            "max_speakers": { "type": "integer", "default": 4 },
            "known_speaker_references": { "type": "boolean", "default": true },
            "reference_audio_min_seconds": { "type": "integer", "default": 2 },
            "reference_audio_max_seconds": { "type": "integer", "default": 10 },
            "response_formats": {
              "type": "array",
              "items": { "type": "string" },
              "default": ["json", "text", "diarized_json"]
            },
            "chunking_strategy": {
              "type": "object",
              "properties": {
                "auto": { "type": "boolean", "default": true },
                "vad_enabled": { "type": "boolean", "default": true },
                "required_for_long_audio": { "type": "boolean", "default": true },
                "long_audio_threshold_seconds": { "type": "integer", "default": 30 }
              }
            },
            "pricing": {
              "type": "object",
              "properties": {
                "text_input_per_1m_tokens": { "type": "number", "default": 2.50 },
                "text_output_per_1m_tokens": { "type": "number", "default": 10.00 },
                "audio_input_per_1m_tokens": { "type": "number", "default": 6.00 },
                "per_minute": { "type": "number", "default": 0.006 },
                "unit": { "type": "string", "default": "USD" }
              }
            }
          }
        }
      }
    },
    "realtime_models": {
      "type": "object",
      "description": "Realtime API models for speech-to-speech interactions",
      "properties": {
        "gpt_realtime": {
          "type": "object",
          "description": "Latest realtime model for voice agents (GA)",
          "properties": {
            "model_id": { "type": "string", "const": "gpt-realtime" },
            "enabled": { "type": "boolean", "default": true },
            "use_case": { "type": "string", "default": "Production voice agents, low-latency conversations" },
            "supported_voices": {
              "type": "array",
              "items": { "type": "string" },
              "default": ["alloy", "ash", "ballad", "coral", "echo", "fable", "onyx", "nova", "sage", "shimmer", "verse", "cedar", "marin"]
            },
            "connection_methods": {
              "type": "array",
              "items": { "type": "string" },
              "default": ["webrtc", "websocket", "sip"]
            },
            "features": {
              "type": "object",
              "properties": {
                "function_calling": { "type": "boolean", "default": true },
                "agent_handoff": { "type": "boolean", "default": true },
                "vad": { "type": "boolean", "default": true },
                "interruption_handling": { "type": "boolean", "default": true },
                "multimodal_input": { "type": "boolean", "default": true },
                "image_input": { "type": "boolean", "default": true }
              }
            },
            "pricing": {
              "type": "object",
              "properties": {
                "text_input_per_1m_tokens": { "type": "number", "default": 4.00 },
                "text_output_per_1m_tokens": { "type": "number", "default": 16.00 },
                "audio_input_per_1m_tokens": { "type": "number", "default": 32.00 },
                "audio_output_per_1m_tokens": { "type": "number", "default": 64.00 },
                "image_input_per_1m_tokens": { "type": "number", "default": 5.00 },
                "unit": { "type": "string", "default": "USD" }
              }
            }
          }
        },
        "gpt_realtime_mini": {
          "type": "object",
          "description": "Cost-efficient realtime model",
          "properties": {
            "model_id": { "type": "string", "const": "gpt-realtime-mini" },
            "enabled": { "type": "boolean", "default": true },
            "use_case": { "type": "string", "default": "High volume voice agents, cost-sensitive deployments" },
            "supported_voices": {
              "type": "array",
              "items": { "type": "string" },
              "default": ["alloy", "ash", "ballad", "coral", "echo", "fable", "onyx", "nova", "sage", "shimmer", "verse", "cedar", "marin"]
            },
            "connection_methods": {
              "type": "array",
              "items": { "type": "string" },
              "default": ["webrtc", "websocket", "sip"]
            },
            "pricing": {
              "type": "object",
              "properties": {
                "text_input_per_1m_tokens": { "type": "number", "default": 0.60 },
                "text_output_per_1m_tokens": { "type": "number", "default": 2.40 },
                "audio_input_per_1m_tokens": { "type": "number", "default": 10.00 },
                "audio_output_per_1m_tokens": { "type": "number", "default": 20.00 },
                "image_input_per_1m_tokens": { "type": "number", "default": 0.80 },
                "unit": { "type": "string", "default": "USD" }
              }
            }
          }
        },
        "gpt_4o_realtime_preview": {
          "type": "object",
          "description": "GPT-4o Realtime Preview (legacy)",
          "properties": {
            "model_id": { "type": "string", "const": "gpt-4o-realtime-preview" },
            "enabled": { "type": "boolean", "default": true },
            "use_case": { "type": "string", "default": "Preview features, compatibility with existing integrations" },
            "pricing": {
              "type": "object",
