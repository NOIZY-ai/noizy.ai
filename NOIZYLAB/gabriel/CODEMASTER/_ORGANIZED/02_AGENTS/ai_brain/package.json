{
  "name": "ai-complete-brain",
  "version": "1.0.0",
  "description": "GABRIEL AI System - Unified AI Worker, Pattern Intelligence, and Knowledge Graph",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx GABRIEL_TEST_SUITE.ts",
