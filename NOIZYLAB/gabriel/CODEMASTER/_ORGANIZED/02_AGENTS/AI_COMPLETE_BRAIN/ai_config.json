{
     "default": "nvidia",
     "hub": "noizylab_console.py",
     "providers": {
          "openai": {
               "enabled": true,
               "mode": "api",
               "envKey": "OPENAI_API_KEY",
               "models": [
                    "gpt-4o",
                    "gpt-4o-mini",
                    "o1-preview"
               ]
          },
          "codex": {
               "enabled": true,
               "mode": "cli"
          },
          "claude": {
               "enabled": true,
               "mode": "api",
               "envKey": "ANTHROPIC_API_KEY",
               "models": [
                    "claude-3-5-sonnet-20240620",
                    "claude-3-opus-20240229"
               ]
          },
          "gemini": {
               "enabled": true,
               "mode": "api",
               "envKey": "GEMINI_API_KEY",
               "models": [
                    "gemini-1.5-flash",
                    "gemini-1.5-pro",
                    "gemini-2.0-flash-exp"
               ]
          },
          "nvidia": {
               "enabled": true,
               "mode": "nim",
               "envKey": "NVIDIA_API_KEY",
               "models": [
                    "nvidia/llama-3.1-nemotron-70b-instruct",
                    "nvidia/nemotron-4-340b-instruct"
               ]
          },
          "deepseek": {
               "enabled": true,
               "mode": "api",
               "envKey": "DEEPSEEK_API_KEY",
               "models": [
                    "deepseek-chat",
                    "deepseek-reasoner"
               ]
          },
          "m365": {
               "enabled": false,
               "mode": "graph"
          }
     }
}