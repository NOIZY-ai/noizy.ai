        else:
            print(f"  {name}: OFFLINE")
    print()


def cmd_tui():
    """Launch the full TUI."""
    os.chdir(TITANHIVE_DIR)
    os.execvp("python3", ["python3", str(TITANHIVE_DIR / "main.py")])


def main():
    if len(sys.argv) < 2:
        cmd_tui()
        return

    cmd = sys.argv[1].lower()
    args = sys.argv[2:]

    commands = {
        "status": cmd_status,
        "models": cmd_models,
        "gpu": cmd_gpu,
        "top": cmd_top,
        "optimize": cmd_optimize,
        "speed": cmd_speed,
        "ping": cmd_ping,
        "omen": cmd_omen,
        "wake": cmd_wake,
        "bench": cmd_bench,
        "tui": cmd_tui,
        "help": lambda: print(__doc__),
        "-h": lambda: print(__doc__),
        "--help": lambda: print(__doc__),
    }

    if cmd == "voice":
        subcmd = args[0] if args else None
        arg = " ".join(args[1:]) if len(args) > 1 else None
        cmd_voice(subcmd, arg)
    elif cmd == "speak":
        cmd_speak(" ".join(args) if args else "Hello from Gabriel")
    elif cmd == "ask":
        cmd_ask(" ".join(args) if args else "Hello")
    elif cmd == "use":
        if args:
            cmd_use(args[0])
        else:
            print("Usage: titan use <model>")
            cmd_models()
    elif cmd == "race":
        cmd_race(" ".join(args) if args else "What is AI?")
    elif cmd in commands:
        commands[cmd]()
    else:
        print(f"Unknown command: {cmd}")
        print(__doc__)


if __name__ == "__main__":
    main()
