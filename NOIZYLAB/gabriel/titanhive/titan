def speak_with_effect(text, voice=None, rate=180, effect=None):
    """Advanced speech with effects."""
    voice = voice or GABRIEL_VOICE

    if effect == "echo":
        # Speak twice with slight delay for echo effect
        subprocess.Popen(["say", "-v", voice, "-r", str(rate), text])
        time.sleep(0.15)
        subprocess.run(["say", "-v", voice, "-r", str(rate - 10), text])
    elif effect == "dramatic":
        # Word by word with pauses
        words = text.split()
        for word in words:
            subprocess.run(["say", "-v", voice, "-r", str(rate), word])
            time.sleep(0.15)
    elif effect == "crescendo":
        # Start slow, speed up
        words = text.split()
        for i, word in enumerate(words):
            r = rate - 50 + (i * 15)
            subprocess.run(["say", "-v", voice, "-r", str(min(r, 300)), word])
    elif effect == "decrescendo":
        # Start fast, slow down
        words = text.split()
        for i, word in enumerate(words):
            r = rate + 50 - (i * 15)
            subprocess.run(["say", "-v", voice, "-r", str(max(r, 100)), word])
    else:
        subprocess.run(["say", "-v", voice, "-r", str(rate), text])


def cmd_speak(text, style="normal"):
    """Text to speech with Oliver (Enhanced) voice and style."""
    style_config = VOICE_STYLES.get(style, VOICE_STYLES["normal"])
    rate, pause, _ = style_config

    if pause > 0:
        # Speak with pauses between sentences
        sentences = text.replace('!', '.').replace('?', '.').split('.')
        for sentence in sentences:
            sentence = sentence.strip()
            if sentence:
                subprocess.run(["say", "-v", GABRIEL_VOICE, "-r", str(rate), sentence])
                time.sleep(pause)
    else:
        subprocess.run(["say", "-v", GABRIEL_VOICE, "-r", str(rate), text])


