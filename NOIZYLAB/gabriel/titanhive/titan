    print("─" * 40)
    nodes = [
        ("Ollama", "localhost", 11434),
        ("HP Omen", OMEN_HOST, 22),
        ("Internet", "8.8.8.8", 53),
    ]
    for name, host, port in nodes:
        start = time.perf_counter()
        ok = check_host(host, port, timeout=2.0)
        latency = (time.perf_counter() - start) * 1000
        if ok:
